generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                  @id @default(cuid())
  email                     String                  @unique
  name                      String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  password                  String
  role                      UserRole                @default(USER)
  completedSalesCreated     CompletedSale[]
  internalSaleQuotesCreated InternalSaleQuote[]
  internalSaleQuoteNotes    InternalSaleQuoteNote[]
}

model Category {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  imageMobileUrl      String?
  imageWebUrl         String?
  imageWebPublicId    String?
  imageMobilePublicId String?
  products            Product[]
}

model Product {
  id                 String                  @id @default(cuid())
  name               String
  slug               String                  @unique
  description        String?
  isActive           Boolean                 @default(true)
  categoryId         String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  baseCost           Decimal?                @db.Decimal(12, 2)
  costCurrency       String                  @default("MXN")
  completedSaleItems CompletedSaleItem[]
  internalQuoteItems InternalSaleQuoteItem[]
  category           Category                @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  variants           ProductVariant[]
  quoteRequestItems  QuoteRequestItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                 String                  @id @default(cuid())
  size               String
  color              String
  sku                String?                 @unique
  isActive           Boolean                 @default(true)
  stock              Int?
  productId          String
  completedSaleItems CompletedSaleItem[]
  internalQuoteItems InternalSaleQuoteItem[]
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id                String             @id @default(cuid())
  customerName      String
  customerEmail     String?
  customerPhone     String
  customerCity      String?
  notes             String?
  status            QuoteRequestStatus @default(NEW)
  source            QuoteRequestSource @default(WEB_FORM)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  internalNotes     String[]           @default([])
  convertedAt       DateTime?
  internalSaleQuote InternalSaleQuote?
  items             QuoteRequestItem[]

  @@map("quote_requests")
}

model QuoteRequestItem {
  id                   String       @id @default(cuid())
  quoteRequestId       String
  productId            String
  productNameSnapshot  String
  productSlugSnapshot  String
  size                 String
  color                String
  quantity             Int          @default(1)
  createdAt            DateTime     @default(now())
  baseCostSnapshot     Decimal?     @db.Decimal(12, 2)
  costCurrencySnapshot String?
  product              Product      @relation(fields: [productId], references: [id])
  quoteRequest         QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@index([productId])
  @@map("quote_request_items")
}

model StoreConfig {
  id            Int      @id @default(1)
  whatsappPhone String
  storeName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InternalSaleQuote {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  status               InternalSaleQuoteStatus @default(DRAFT)
  customerName         String
  customerPhone        String?
  customerEmail        String?
  customerCity         String?
  notes                String?
  currency             String                  @default("MXN")
  subtotal             Decimal                 @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal                 @default(0) @db.Decimal(14, 2)
  totalRevenue         Decimal                 @default(0) @db.Decimal(14, 2)
  totalCost            Decimal                 @default(0) @db.Decimal(14, 2)
  totalProfit          Decimal                 @default(0) @db.Decimal(14, 2)
  marginPct            Decimal?                @db.Decimal(7, 4)
  publicQuoteRequestId String?                 @unique
  createdByUserId      String
  approvedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  completedSale        CompletedSale?
  createdBy            User                    @relation(fields: [createdByUserId], references: [id])
  publicQuoteRequest   QuoteRequest?           @relation(fields: [publicQuoteRequestId], references: [id])
  items                InternalSaleQuoteItem[]
  internalNotes        InternalSaleQuoteNote[]

  @@index([status])
  @@index([createdByUserId])
}

model InternalSaleQuoteNote {
  id           String            @id @default(cuid())
  quoteId      String
  authorUserId String
  message      String
  createdAt    DateTime          @default(now())
  author       User              @relation(fields: [authorUserId], references: [id])
  quote        InternalSaleQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([authorUserId])
}

model InternalSaleQuoteItem {
  id                  String            @id @default(cuid())
  quoteId             String
  productId           String?
  variantId           String?
  productNameSnapshot String
  productSlugSnapshot String
  sizeSnapshot        String?
  colorSnapshot       String?
  skuSnapshot         String?
  quantity            Int
  unitSalePrice       Decimal           @db.Decimal(12, 2)
  unitCostSnapshot    Decimal           @db.Decimal(12, 2)
  lineRevenue         Decimal           @db.Decimal(14, 2)
  lineCost            Decimal           @db.Decimal(14, 2)
  lineProfit          Decimal           @db.Decimal(14, 2)
  discountType        DiscountType?
  discountValue       Decimal?          @db.Decimal(12, 2)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  product             Product?          @relation(fields: [productId], references: [id])
  quote               InternalSaleQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant             ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([quoteId])
  @@index([productId])
  @@index([variantId])
}

model CompletedSale {
  id              String              @id @default(cuid())
  saleNumber      String              @unique
  quoteId         String?             @unique
  status          CompletedSaleStatus @default(COMPLETED)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerCity    String?
  currency        String              @default("MXN")
  subtotal        Decimal             @db.Decimal(14, 2)
  discountTotal   Decimal             @db.Decimal(14, 2)
  totalRevenue    Decimal             @db.Decimal(14, 2)
  totalCost       Decimal             @db.Decimal(14, 2)
  totalProfit     Decimal             @db.Decimal(14, 2)
  marginPct       Decimal?            @db.Decimal(7, 4)
  notes           String?
  createdByUserId String
  completedAt     DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation(fields: [createdByUserId], references: [id])
  quote           InternalSaleQuote?  @relation(fields: [quoteId], references: [id])
  items           CompletedSaleItem[]

  @@index([status])
  @@index([createdByUserId])
}

model CompletedSaleItem {
  id                  String          @id @default(cuid())
  saleId              String
  productId           String?
  variantId           String?
  productNameSnapshot String
  productSlugSnapshot String
  sizeSnapshot        String?
  colorSnapshot       String?
  skuSnapshot         String?
  quantity            Int
  unitSalePrice       Decimal         @db.Decimal(12, 2)
  unitCostSnapshot    Decimal         @db.Decimal(12, 2)
  lineRevenue         Decimal         @db.Decimal(14, 2)
  lineCost            Decimal         @db.Decimal(14, 2)
  lineProfit          Decimal         @db.Decimal(14, 2)
  discountType        DiscountType?
  discountValue       Decimal?        @db.Decimal(12, 2)
  createdAt           DateTime        @default(now())
  product             Product?        @relation(fields: [productId], references: [id])
  sale                CompletedSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
}

enum UserRole {
  ADMIN
  USER
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
  REJECTED
  CONVERTED
}

enum QuoteRequestSource {
  WEB_FORM
  WHATSAPP
}

enum InternalSaleQuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  COMPLETED
}

enum CompletedSaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}
